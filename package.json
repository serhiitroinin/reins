{
  "name": "@fold-harness/core",
  "version": "0.1.0-next.0",
  "description": "A provider-neutral runtime for building domain-specific agent harnesses.",
  "type": "module",
  "license": "MIT",
  "author": "Serhii Troinin",
  "homepage": "https://github.com/serhiitroinin/fold-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhiitroinin/fold-harness.git"
  },
  "bugs": {
    "url": "https://github.com/serhiitroinin/fold-harness/issues"
  },
  "keywords": [
    "agents",
    "harness",
    "codex",
    "claude",
    "acp",
    "mcp"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./transports/ndjson": {
      "types": "./dist/transports/ndjson.d.ts",
      "import": "./dist/transports/ndjson.js"
    },
    "./transports/json-rpc": {
      "types": "./dist/transports/json-rpc.d.ts",
      "import": "./dist/transports/json-rpc.js"
    },
    "./adapters/codex-app-server": {
      "types": "./dist/adapters/codex-app-server.d.ts",
      "import": "./dist/adapters/codex-app-server.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

